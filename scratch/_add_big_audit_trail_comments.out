生成的 SQL:
ALTER TABLE `big_audit_trail` COMMENT = '审计大表(分片键 id)',
  MODIFY COLUMN `trace_id` varchar(64) COLLATE utf8mb4_bin NOT NULL COMMENT '链路追踪ID',
  MODIFY COLUMN `operator` varchar(100) COLLATE utf8mb4_bin NOT NULL COMMENT '操作人',
  MODIFY COLUMN `module` varchar(80) COLLATE utf8mb4_bin NULL COMMENT '操作模块',
  MODIFY COLUMN `action` varchar(50) COLLATE utf8mb4_bin NULL COMMENT '操作类型',
  MODIFY COLUMN `target_type` varchar(50) COLLATE utf8mb4_bin NULL COMMENT '操作对象类型',
  MODIFY COLUMN `target_id` varchar(64) COLLATE utf8mb4_bin NULL COMMENT '操作对象ID',
  MODIFY COLUMN `detail` varchar(600) COLLATE utf8mb4_bin NULL COMMENT '操作详情',
  MODIFY COLUMN `ip_address` varchar(45) COLLATE utf8mb4_bin NULL COMMENT '客户端IP地址',
  MODIFY COLUMN `user_agent` varchar(300) COLLATE utf8mb4_bin NULL COMMENT '客户端User-Agent',
  MODIFY COLUMN `request_body` varchar(800) COLLATE utf8mb4_bin NULL COMMENT '请求体摘要',
  MODIFY COLUMN `response_code` int NULL COMMENT '响应码',
  MODIFY COLUMN `duration_ms` int NULL COMMENT '处理耗时(毫秒)',
  MODIFY COLUMN `event_time` datetime NOT NULL COMMENT '事件发生时间'

