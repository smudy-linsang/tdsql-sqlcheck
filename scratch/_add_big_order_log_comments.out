生成的 SQL:
ALTER TABLE `big_order_log` COMMENT = '大订单日志表',
  MODIFY COLUMN `order_no` varchar(64) COLLATE utf8mb4_bin NOT NULL COMMENT '订单号',
  MODIFY COLUMN `user_id` bigint NOT NULL COMMENT '用户ID',
  MODIFY COLUMN `product_name` varchar(200) COLLATE utf8mb4_bin NOT NULL COMMENT '商品名称',
  MODIFY COLUMN `category` varchar(100) COLLATE utf8mb4_bin NULL COMMENT '商品分类',
  MODIFY COLUMN `amount` decimal(12,2) NULL COMMENT '订单金额(元)',
  MODIFY COLUMN `status` varchar(20) COLLATE utf8mb4_bin NULL COMMENT '订单状态',
  MODIFY COLUMN `channel` varchar(50) COLLATE utf8mb4_bin NULL COMMENT '下单渠道',
  MODIFY COLUMN `region` varchar(50) COLLATE utf8mb4_bin NULL COMMENT '下单区域',
  MODIFY COLUMN `remark` varchar(500) COLLATE utf8mb4_bin NULL COMMENT '订单备注',
  MODIFY COLUMN `extra_info` varchar(800) COLLATE utf8mb4_bin NULL COMMENT '扩展信息',
  MODIFY COLUMN `create_time` datetime NOT NULL COMMENT '创建时间',
  MODIFY COLUMN `update_time` datetime NULL COMMENT '更新时间'

