# ZK automatic-discovery deployment configuration (do not commit actual values).
# The backend reads these values; the browser must not submit ZK endpoints or credentials.

# Comma-separated candidates. The service tries one node at a time.
ZK_DISCOVERY_SERVERS=zk-a.example.internal:2118,zk-b.example.internal:2118,zk-c.example.internal:2118
ZK_DISCOVERY_ROOT=/tdsqlzk
ZK_DISCOVERY_ZKCLI_PATH=/opt/zookeeper/bin/zkCli.sh
ZK_DISCOVERY_PROXY_MODE=first
ZK_DISCOVERY_DEFAULT_DATABASE=ALL

# A JSON object that maps a ZK private proxy host to the address CheckSQL actually uses.
ZK_DISCOVERY_ENDPOINT_MAP={"10.0.0.10":"db-proxy-a.example.internal","10.0.0.11":"db-proxy-b.example.internal"}

# Absolute, deployment-local secret file. Never put its content in this file, source code or a browser.
ZK_DISCOVERY_AUTH_FILE=/run/secrets/tdsql-sqlcheck/zk-discovery-auth.json

# Test-only switch. It must remain unset in every real environment.
# ZK_DISCOVERY_FORCE_MOCK=1
